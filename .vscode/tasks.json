{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Firefox Dev Watcher",
            "type": "shell",
            "command": "pnpm",
            "args": ["dev:firefox"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "vite v.* building for development\\.\\.\\.",
                    "endsPattern": "built in [0-9.]+\\S"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            }
        }
    ]
}